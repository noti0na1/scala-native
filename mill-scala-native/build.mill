//| mill-version: 1.3.1
package build

import mill.*
import mill.api.BuildCtx
import mill.scalalib.*
import mill.scalalib.publish.*

/** The Mill plugin that compiles Scala Native modules with `snc`, and the
 *  worker it loads, published with the version of this repository's other
 *  artifacts:
 *
 *  {{{
 *  mill __.publishLocal
 *  }}}
 *
 *  The worker compiles the sbt plugin's `snc` sources, which run `snc` under
 *  Zinc, with the Zinc version Mill uses, so that Mill reads the analyses it
 *  writes.
 */
object Versions {

  /** The version of this repository's artifacts, as a local build publishes
   *  them (`project/ScalaNativeBuildInfo.scala`).
   */
  val scalaNative: String = {
    val file = BuildCtx.workspaceRoot / os.up / "project" / "ScalaNativeBuildInfo.scala"
    val buildInfo = BuildCtx.withFilesystemCheckerDisabled(os.read(file))
    val base = "baseVersion = \"([^\"]+)\"".r
      .findFirstMatchIn(buildInfo)
      .getOrElse(sys.error("no baseVersion in project/ScalaNativeBuildInfo.scala"))
      .group(1)
    s"$base-SNAPSHOT"
  }
}

trait SncPublishModule extends ScalaModule with PublishModule {
  def scalaVersion = mill.util.BuildInfo.scalaVersion
  def publishVersion = Versions.scalaNative
  def scalacOptions = Seq("-deprecation", "-feature")
  def pomSettings = PomSettings(
    description = artifactName(),
    organization = "org.scala-native",
    url = "https://github.com/scala-native/scala-native",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("scala-native", "scala-native"),
    developers = Nil
  )
}

/** The plugin, for Mill 1 (`mill-scala-native-snc_mill1_3`). */
object plugin extends SncPublishModule {
  def artifactName = "mill-scala-native-snc"
  def platformSuffix = s"_mill${mill.util.BuildInfo.millBinPlatform}"
  def compileMvnDeps = Seq(
    mvn"com.lihaoyi::mill-libs-scalanativelib:${mill.util.BuildInfo.millVersion}"
  )
  def generatedSources = Task {
    os.write(
      Task.dest / "SncPluginBuildInfo.scala",
      s"""package mill.scalanativelib.snc
         |
         |/** Generated by mill-scala-native/build.mill. */
         |private[snc] object SncPluginBuildInfo {
         |  val worker: String = "org.scala-native:${worker.artifactId()}:${Versions.scalaNative}"
         |}
         |""".stripMargin
    )
    Seq(PathRef(Task.dest))
  }
}

/** The worker: Zinc around `snc`, in a class loader of its own. */
object worker extends SncPublishModule {
  def artifactName = "mill-scala-native-snc-worker"
  def sources = Task.Sources(
    moduleDir / "src",
    moduleDir / os.up / os.up / "sbt-scala-native" / "src" / "main" / "scala" /
      "scala" / "scalanative" / "sbtplugin" / "snc"
  )
  def mvnDeps = Seq(
    mvn"org.scala-sbt::zinc:${mill.javalib.api.Versions.zinc}",
    // For an `snc` without the analysis, whose output the sources read.
    mvn"org.scala-native:nir_2.13:${Versions.scalaNative}"
  )
}
